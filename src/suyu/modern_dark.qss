/* Modern Dark Theme for Suyu Emulator */

/* Main Window */
QMainWindow {
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Menu Bar */
QMenuBar {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 4px;
    margin: 2px;
}

QMenuBar::item:selected {
    background-color: #404040;
}

QMenuBar::item:pressed {
    background-color: #505050;
}

/* Menu */
QMenu {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 4px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: #404040;
}

QMenu::separator {
    height: 1px;
    background-color: #404040;
    margin: 4px 8px;
}

/* Status Bar */
QStatusBar {
    background-color: #2d2d2d;
    color: #ffffff;
    border-top: 1px solid #404040;
}

/* Game Library Container */
#gameLibraryContainer {
    background-color: #1a1a1a;
    border: none;
}

/* Game Card Styling */
.GameCard {
    background-color: #2d2d2d;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 8px;
    margin: 4px;
}

.GameCard:hover {
    border-color: #7c3aed;
    background-color: #353535;
}

.GameCard:focus {
    border-color: #7c3aed;
    background-color: #353535;
}

.GameCard QLabel {
    color: #ffffff;
    background-color: transparent;
}

.GameCard .title {
    font-size: 14px;
    font-weight: bold;
    color: #ffffff;
}

.GameCard .subtitle {
    font-size: 12px;
    color: #cccccc;
}

/* Scroll Area */
QScrollArea {
    background-color: #1a1a1a;
    border: none;
}

QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #505050;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #606060;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #2d2d2d;
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #505050;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #606060;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Search Bar */
QLineEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border-color: #7c3aed;
}

QLineEdit::placeholder {
    color: #888888;
}

/* Buttons */
QPushButton {
    background-color: #7c3aed;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #8b5cf6;
}

QPushButton:pressed {
    background-color: #6d28d9;
}

QPushButton:disabled {
    background-color: #404040;
    color: #888888;
}

/* Secondary Button */
QPushButton.secondary {
    background-color: #404040;
    color: #ffffff;
}

QPushButton.secondary:hover {
    background-color: #505050;
}

QPushButton.secondary:pressed {
    background-color: #606060;
}

/* Toolbar */
QToolBar {
    background-color: #2d2d2d;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px;
    margin: 2px;
}

QToolButton:hover {
    background-color: #404040;
}

QToolButton:pressed {
    background-color: #505050;
}

QToolButton:checked {
    background-color: #7c3aed;
}

/* Dock Widgets */
QDockWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #404040;
    color: #ffffff;
    padding: 8px;
    border-radius: 4px 4px 0 0;
}

/* Tab Widget */
QTabWidget::pane {
    background-color: #2d2d2d;
    border: 1px solid #404040;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #404040;
    color: #ffffff;
    padding: 8px 16px;
    margin: 2px;
    border-radius: 6px 6px 0 0;
}

QTabBar::tab:selected {
    background-color: #7c3aed;
}

QTabBar::tab:hover {
    background-color: #505050;
}

/* Progress Bar */
QProgressBar {
    background-color: #404040;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #7c3aed;
    border-radius: 4px;
}

/* Splitter */
QSplitter::handle {
    background-color: #404040;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Tree View (for compatibility) */
QTreeView {
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    selection-background-color: #7c3aed;
    alternate-background-color: #252525;
}

QTreeView::item {
    padding: 4px;
    border: none;
}

QTreeView::item:selected {
    background-color: #7c3aed;
}

QTreeView::item:hover {
    background-color: #353535;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #ffffff;
    padding: 8px;
    border: none;
    border-right: 1px solid #404040;
}

/* Combo Box */
QComboBox {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #7c3aed;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #ffffff;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 6px;
    selection-background-color: #7c3aed;
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 6px;
    padding: 6px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #7c3aed;
}

/* Check Box */
QCheckBox {
    color: #ffffff;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 4px;
    background-color: #2d2d2d;
}

QCheckBox::indicator:checked {
    background-color: #7c3aed;
    border-color: #7c3aed;
}

QCheckBox::indicator:hover {
    border-color: #7c3aed;
}

/* Radio Button */
QRadioButton {
    color: #ffffff;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 9px;
    background-color: #2d2d2d;
}

QRadioButton::indicator:checked {
    background-color: #7c3aed;
    border-color: #7c3aed;
}

QRadioButton::indicator:hover {
    border-color: #7c3aed;
}

/* Slider */
QSlider::groove:horizontal {
    background-color: #404040;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #7c3aed;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #8b5cf6;
}

/* Group Box */
QGroupBox {
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    background-color: #1a1a1a;
}

/* Dialog */
QDialog {
    background-color: #1a1a1a;
    color: #ffffff;
}

/* Message Box */
QMessageBox {
    background-color: #1a1a1a;
    color: #ffffff;
}

QMessageBox QPushButton {
    min-width: 80px;
    margin: 4px;
}

/* Tooltip */
QToolTip {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 4px 8px;
}